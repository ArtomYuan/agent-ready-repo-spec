{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Edit(./reports/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./.github/CODEOWNERS)",
      "Edit(./.claude/**)",
      "Bash(rm *)",
      "Bash(git reset *)",
      "Bash(sh *)",
      "Bash(bash *)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/guard-push.ps1"
          }
        ]
      }
    ]
  }
}
