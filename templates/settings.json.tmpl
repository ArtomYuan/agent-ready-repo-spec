{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Edit(./{{PROTECTED_DIR}}/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./.github/CODEOWNERS)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Bash(rm *)",
      "Bash(git reset *)",
      "Bash(sh *)",
      "Bash(bash *)"
    ],
    "allow": [
      "Bash({{TEST_CMD}}:*)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ]
  }
}
