{
  "$schema": "{{SETTINGS_SCHEMA_URL}}",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Edit(./{{PROTECTED_DIR}}/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./.github/CODEOWNERS)",
      "Edit(./AGENTS.md)",
      "Edit(./{{TOOL_SPECIFIC_INSTRUCTION_FILE}})",
      "Edit(./{{TOOL_ASSET_DIR}}/**)",
      "Bash(rm *)",
      "Bash(git reset *)",
      "Bash(sh *)",
      "Bash(bash *)"
    ],
    "allow": [
      "Bash({{TEST_CMD}}:*)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ]
  }
}
