# 默认：文本按 LF 归一，避免 Windows/macOS 协作产生整文件 diff
* text=auto eol=lf

# 显式声明语言（便于 GitHub 统计与 diff 高亮）
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# 二进制：禁止 diff、禁止行尾转换
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary

# 生成物：在 PR 里折叠，减少噪音
spec/RULES.md linguist-generated=true
